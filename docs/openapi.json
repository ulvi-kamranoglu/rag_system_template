{
  "openapi": "3.1.0",
  "info": {
    "title": "UNEC AI Assistant API",
    "description": "Source-grounded university question answering. Streaming uses NDJSON.",
    "version": "1.0.0"
  },
  "paths": {
    "/admin/pipeline/collect": {
      "post": {
        "tags": [
          "Pipeline administration"
        ],
        "summary": "Collect",
        "operationId": "collect_admin_pipeline_collect_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "sources",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CollectionSource"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional subset of sources to collect. Empty: every source enabled in the collection config. Selecting a disabled source returns 422.",
              "title": "Sources"
            },
            "description": "Optional subset of sources to collect. Empty: every source enabled in the collection config. Selecting a disabled source returns 422."
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/pipeline/sources": {
      "get": {
        "tags": [
          "Pipeline administration"
        ],
        "summary": "Sources",
        "description": "Collection sources known to the configuration and whether each is enabled.",
        "operationId": "sources_admin_pipeline_sources_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/admin/pipeline/join": {
      "post": {
        "tags": [
          "Pipeline administration"
        ],
        "summary": "Join",
        "operationId": "join_admin_pipeline_join_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_join_admin_pipeline_join_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/admin/pipeline/reset-data": {
      "post": {
        "tags": [
          "Pipeline administration"
        ],
        "summary": "Replace the active dataset with an uploaded dataset",
        "operationId": "reset_data_admin_pipeline_reset_data_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_reset_data_admin_pipeline_reset_data_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/admin/pipeline/runs": {
      "get": {
        "tags": [
          "Pipeline administration"
        ],
        "summary": "Runs",
        "operationId": "runs_admin_pipeline_runs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/admin/pipeline/runs/{run_id}": {
      "get": {
        "tags": [
          "Pipeline administration"
        ],
        "summary": "Status",
        "operationId": "status_admin_pipeline_runs__run_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/pipeline/runs/{run_id}/resume": {
      "post": {
        "tags": [
          "Pipeline administration"
        ],
        "summary": "Resume",
        "operationId": "resume_admin_pipeline_runs__run_id__resume_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/pipeline/runs/{run_id}/logs": {
      "get": {
        "tags": [
          "Pipeline administration"
        ],
        "summary": "Logs",
        "operationId": "logs_admin_pipeline_runs__run_id__logs_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "stage",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "worker",
                "collection",
                "canonical",
                "chunk",
                "embedding",
                "retrieval"
              ],
              "type": "string",
              "default": "worker",
              "title": "Stage"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Ready",
        "description": "Startup readiness, not a live probe of every downstream service.",
        "operationId": "ready_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "tags": [
          "Conversation"
        ],
        "summary": "Ask",
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/ask/stream": {
      "post": {
        "tags": [
          "Conversation"
        ],
        "summary": "Ask Stream",
        "operationId": "ask_stream_ask_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "One JSON event per line: query, token, done or error.",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Question"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 20,
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "search_query": {
            "type": "string",
            "title": "Search Query"
          },
          "timings": {
            "$ref": "#/components/schemas/Timings"
          },
          "intent": {
            "type": "string",
            "title": "Intent"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "show_sources": {
            "type": "boolean",
            "title": "Show Sources"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "sources",
          "search_query",
          "timings",
          "intent",
          "language",
          "show_sources"
        ],
        "title": "AskResponse"
      },
      "Body_join_admin_pipeline_join_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Raw Parquet dataset; replaces the shared 01_raw contents after archival"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_join_admin_pipeline_join_post"
      },
      "Body_reset_data_admin_pipeline_reset_data_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Complete replacement Parquet dataset. Old records will not be retained; the canonical version increments."
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_reset_data_admin_pipeline_reset_data_post"
      },
      "CollectionSource": {
        "type": "string",
        "enum": [
          "wordpress/pages",
          "wordpress/posts",
          "instagram/uneceduaz",
          "instagram/adalat.muradov",
          "news"
        ],
        "title": "CollectionSource"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "loading",
              "error"
            ],
            "title": "Status"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "retriever_ready": {
            "type": "boolean",
            "title": "Retriever Ready"
          },
          "llm_ready": {
            "type": "boolean",
            "title": "Llm Ready"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status",
          "model",
          "retriever_ready",
          "llm_ready",
          "error"
        ],
        "title": "HealthResponse"
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "Source": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "title",
          "url",
          "date"
        ],
        "title": "Source"
      },
      "Timings": {
        "properties": {
          "translate": {
            "type": "number",
            "title": "Translate"
          },
          "search": {
            "type": "number",
            "title": "Search"
          },
          "llm": {
            "type": "number",
            "title": "Llm"
          }
        },
        "type": "object",
        "required": [
          "translate",
          "search",
          "llm"
        ],
        "title": "Timings"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
