# Copy to .env. Run commands from this project's root.
PYTHONUTF8=1
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Public prefix stripped by a reverse proxy; leave empty for root deployment.
# SERVER_ROOT_PATH=/assistant
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=unec-assistant

# Optional service key for /ask and /ask/stream (X-API-Key header).
# Set before exposing to other applications. Empty disables API authentication.
# Keep shared keys in the integrating backend/gateway, not public browser code.
ASSISTANT_API_KEY=

# Separate admin key for /admin/pipeline/*. Empty disables all pipeline endpoints.
ASSISTANT_ADMIN_API_KEY=

# Comma-separated browser origins. Empty disables cross-origin browser access.
# CORS_ORIGINS=https://assistant.unec.edu.az,http://localhost:3000
CORS_ORIGINS=

EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=unec_chunks
VECTOR_BACKEND=qdrant

# Optional: source filename stem, without .parquet or stage suffixes.
# PIPELINE_DATASET=chatbot_dataset_v1.4
# Optional YAML path shared by embedding batch and query callers.
# EMBEDDING_CONFIG=C:/path/to/04_embedding/config/config.yaml

# Optional assistant overrides; defaults live in assistant_app/config/config.yaml.
# ASSISTANT_CONFIG=C:/path/to/assistant.yaml
# OLLAMA_URL=http://127.0.0.1:11434
# LLM_MODEL=unec-assistant
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
# TOP_K=8
# HISTORY_TURNS=3
